# Database
DATABASE_URL=postgresql+asyncpg://fabbi:fabbi_secret@localhost:5432/postgres

# Redis
# Local-development placeholder. Required by docker-compose, which refuses to
# start Redis or the backend without it. URL-encode it inside REDIS_URL if it
# ever contains characters such as @ : or /.
REDIS_PASSWORD=change-me-local-redis-password
REDIS_URL=redis://:change-me-local-redis-password@localhost:6379/0

# JWT
JWT_SECRET=super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend
VITE_API_URL=http://localhost:8000

# Optional seed sizes
SEED_USERS=100
SEED_TODOS=1000
